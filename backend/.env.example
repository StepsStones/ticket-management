# StepsStone Ticket Management System - Environment Variables
PROJECT_NAME="StepsStone Ticket Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# PostgreSQL Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:Rajesh_2005@127.0.0.1:5432/stepsstone_tickets"

# Security Secrets
